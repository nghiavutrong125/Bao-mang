---
import Github from "@/assets/svgs/github.astro";
import Search01 from "@/assets/svgs/search-01.astro";
import MenuDropdown from "./menu-dropdown.astro";
import { SITE } from "@/lib/config";
import ThemeController from "../bases/theme-controller.astro";
---

<div
  class="navbar border-b border-primary-content/80 dark:border-primary-content/20"
>
  <div class="navbar-start lg:w-1/2">
    <MenuDropdown />
    <a class="flex items-center gap-2 text-xl px-2 text-nowrap lg:hidden font-serif font-bold tracking-wider" href="/">
      <img src="/logo.png" alt={SITE.title} class="h-8 w-8 object-contain rounded" />
      <span>{SITE.title}</span>
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <a class="flex items-center gap-3 text-2xl font-serif font-bold tracking-wider px-2" href="/">
      <img src="/logo.png" alt={SITE.title} class="h-10 w-10 object-contain rounded" />
      <span>{SITE.title}</span>
    </a>
  </div>
  <div class="navbar-end">
    <ThemeController />
    <a class="btn btn-ghost btn-circle" href="/search" aria-label="Search">
      <Search01 />
    </a>
    <a
      class="btn btn-ghost btn-circle"
      href={SITE.github}
      target="_blank"
      aria-label="GitHub"
    >
      <Github />
    </a>
  </div>
</div>
