---
import Search01 from "@/assets/svgs/search-01.astro";
import MenuDropdown from "./menu-dropdown.astro";
import { SITE } from "@/lib/config";
import ThemeController from "../bases/theme-controller.astro";
---

<div
  class="navbar border-b border-primary-content/80 dark:border-primary-content/20 px-2 sm:px-4"
>
  <!-- Left: Menu + Square Icon Logo (BBC / CNN style) -->
  <div class="navbar-start flex items-center gap-2 sm:gap-3">
    <MenuDropdown />
    <a href="/" class="flex items-center" aria-label={SITE.title}>
      <img
        src="/logo.png"
        alt={SITE.title}
        class="h-9 sm:h-11 w-auto max-w-[130px] sm:max-w-[150px] object-contain hover:opacity-90 transition-opacity"
      />
    </a>
  </div>

  <!-- Center: Editorial Newspaper Masthead Text -->
  <div class="navbar-center">
    <a
      href="/"
      class="text-xl sm:text-2xl lg:text-3xl font-serif font-black tracking-tight text-base-content hover:opacity-85 transition-opacity text-nowrap"
    >
      {SITE.title}
    </a>
  </div>

  <!-- Right: Theme Controller + Search -->
  <div class="navbar-end flex items-center gap-1 sm:gap-2">
    <ThemeController />
    <a class="btn btn-ghost btn-circle btn-sm sm:btn-md" href="/search" aria-label="Search">
      <Search01 />
    </a>
  </div>
</div>
